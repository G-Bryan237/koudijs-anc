ADMIN_EMAIL=info@anc.cm
# Generate using node scripts/setup-admin.mjs. Never commit actual credentials.
ADMIN_PASSWORD_HASH=
SESSION_SECRET=
# Only set after choosing the custom HTTPS domain and configuring its reverse proxy.
# SITE_URL=https://your-custom-domain
# DATA_DIRECTORY=/absolute/path/to/persistent/anc-data
# TRUST_PROXY=true

# Required on Vercel: create a remote libSQL database (Turso) and copy its URL/token.
TURSO_DATABASE_URL=
TURSO_AUTH_TOKEN=
